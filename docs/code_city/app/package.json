{
  "name": "code-city",
  "version": "1.0.0",
  "description": "Code City: review your code changes and replay git history in a 3D city. Runs git on your own computer, no server.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node build_app.js",
    "start": "node build_app.js && electron .",
    "dist": "node build_app.js && npx electron-builder --win portable --config.directories.output=dist --config.files=main.js --config.files=preload.js --config.files=history.js --config.files=renderer/**"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  }
}
